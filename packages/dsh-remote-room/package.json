{
  "name": "@yukariyukaro/dsh-remote-room",
  "version": "0.5.3",
  "description": "Consent-based remote workspaces for DeepSeek Harness",
  "license": "MIT",
  "author": "yukariyukaro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yukariyukaro/dsh-remote-room.git",
    "directory": "packages/dsh-remote-room"
  },
  "homepage": "https://github.com/yukariyukaro/dsh-remote-room#readme",
  "bugs": {
    "url": "https://github.com/yukariyukaro/dsh-remote-room/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "remote",
    "workspace",
    "share"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.1-rc.2 <0.2.2"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "src",
    "GUIDE.md",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e tests/security",
    "test:profiles": "node scripts/e2e-profiles.mjs",
    "test:ui:web": "node scripts/e2e-ui-web.mjs",
    "test:ui:desktop": "node scripts/e2e-ui-desktop.mjs",
    "test:unit": "vitest run tests/unit",
    "test:public-relay": "vitest run tests/e2e/public-relay.spec.ts",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "ws": "^8.22.0",
    "@peculiar/x509": "2.2.0",
    "reflect-metadata": "0.2.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-fs": ">=0.2.1-rc.2 <0.2.2",
    "@deepseek-ai/dsh-fs-sandbox": ">=0.2.1-rc.2 <0.2.2",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.2.2",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.2.2",
    "@deepseek-ai/dsh-subprocess": ">=0.2.1-rc.2 <0.2.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.3",
    "@deepseek-ai/dsh-fs-local": "0.2.1-rc.3",
    "@deepseek-ai/dsh-fs-sandbox": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.25.0",
    "tsdown": "^0.15.0",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-resources": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-storage": "0.2.1-rc.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "playwright": "1.64.1",
    "zustand": "4.5.7",
    "immer": "10.1.1",
    "ws": "^8.18.3"
  }
}

